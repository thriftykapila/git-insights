{
  "manifestVersion": 2,
  "id": "git-insights",
  "name": "Git Insights",
  "version": "0.1.1",
  "description": "See who wrote each line of a file (git blame), with hover details and per-commit info.",
  "author": {
    "name": "Thrifty Kapila",
    "url": "https://www.linkedin.com/in/thriftykapila/"
  },
  "homepage": "https://github.com/thriftykapila/git-insights",
  "repository": "https://github.com/thriftykapila/git-insights",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.247"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "git-insights",
        "title": "Git Insights",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    }
  ]
}
